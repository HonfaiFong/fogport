# ===== 应用 =====
APP_NAME=fogport
APP_ENV=local
APP_DEBUG=true
APP_HTTP_PORT=8787
APP_WS_PORT=8788

# 服务端密钥（生产环境必须替换为强随机值）
APP_SECRET=change_me_app_secret_32bytes
# 单帖匿名标识 HMAC 密钥：scoped_token = substr(hmac_sha256(secret, can_id . ':' . user_id), 0, 16)
SCOPED_TOKEN_SECRET=change_me_scoped_token_secret

# ===== PostgreSQL 16 =====
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fogport
DB_USERNAME=fogport
DB_PASSWORD=fogport_dev_pwd
# 仅宿主机调试连接用（容器内仍走 5432）
DB_HOST_PORT=15432

# ===== Redis 7 =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=fogport_dev_pwd
REDIS_DB=0
REDIS_PREFIX=yg:
REDIS_HOST_PORT=16379

# ===== RustFS (S3 兼容，由独立设备提供，不在本地 compose 中启动) =====
# 内网服务端地址：供应用生成 Presigned URL、执行服务端操作使用
RUSTFS_ENDPOINT=http://192.168.1.100:9000
RUSTFS_ACCESS_KEY=fogport
RUSTFS_SECRET_KEY=fogport_dev_secret
RUSTFS_BUCKET=fogport-media
RUSTFS_REGION=us-east-1
RUSTFS_USE_PATH_STYLE=true
# 客户端直传与访问地址：必须能被手机端直接访问（通常与 ENDPOINT 不同）
RUSTFS_PUBLIC_ENDPOINT=http://192.168.1.100:9000

# ===== 鉴权 JWT =====
JWT_ACCESS_SECRET=change_me_jwt_access_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=2592000

# ===== 推送（分阶段接入，本地留空即可）=====
PUSH_APNS_TEAM_ID=
PUSH_APNS_KEY_ID=
PUSH_APNS_KEY_PATH=
PUSH_APNS_BUNDLE_ID=
PUSH_FCM_CREDENTIALS_PATH=